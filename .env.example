# Firebase yapılandırması
REACT_APP_FIREBASE_API_KEY=your_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_auth_domain
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_storage_bucket
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Admin kullanıcı e-posta adresi
REACT_APP_ADMIN_EMAIL=admin@example.com

# İletişim e-postası (Gizlilik Politikası ve veri silme talepleri için)
# REACT_APP_CONTACT_EMAIL=iletisim@ornek.com

# ---------------------------------------------------------------------------
# Reklamlar (ayrıntılar: docs/ADS.md)
# Değişkenler tanımlı değilse tüm reklam kodu no-op çalışır.
# ---------------------------------------------------------------------------
# Reklamları aç/kapat (varsayılan: kapalı)
# REACT_APP_ADS_ENABLED=false
# Test modu: true iken Google'ın resmi TEST reklam birimleri kullanılır (varsayılan: true).
# Yalnızca Play'deki yayın derlemesinde false yapın!
# REACT_APP_ADS_TEST_MODE=true
# Reklamlar kapalıyken reklam alanlarını kesikli çerçeve olarak göster (geliştirme)
# REACT_APP_ADS_DEBUG=false

# Web — Google AdSense
# REACT_APP_ADSENSE_CLIENT=ca-pub-0000000000000000
# REACT_APP_ADSENSE_SLOT_DEFAULT=0000000000
# REACT_APP_ADSENSE_SLOT_PLANNER=
# REACT_APP_ADSENSE_SLOT_RECIPES=
# REACT_APP_ADSENSE_SLOT_RECIPE_DETAIL=
# REACT_APP_ADSENSE_SLOT_EXPORT=

# Android — Google AdMob (uygulama kimliği AndroidManifest.xml'e de yazılmalı)
# REACT_APP_ADMOB_APP_ID=ca-app-pub-0000000000000000~0000000000
# REACT_APP_ADMOB_BANNER_ID=ca-app-pub-0000000000000000/0000000000
# REACT_APP_ADMOB_INTERSTITIAL_ID=ca-app-pub-0000000000000000/0000000000
# Test cihazı kimlikleri (virgülle ayrılmış; UMP onay formunu AB'de gibi test etmek için)
# REACT_APP_ADMOB_TEST_DEVICE_IDS=
